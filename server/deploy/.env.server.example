# EOPP — Server Configuration Template
# Copy to .env.server and fill in your values

# Production server URL (with protocol, no trailing slash)
SERVER_URL=https://your-server-ip-or-domain

# Server hostname (for nginx, certs, etc)
SERVER_HOST=your-server-ip-or-domain

# --- Rucaptcha auto-solver ---
# API key from https://rucaptcha.com (личный кабинет)
RUCAPTCHA_API_KEY=

# Full webhook URL where rucaptcha sends answers
# Local:  http://your-ip:8766/rucaptcha-callback
# Prod:   https://your-server.com/rucaptcha-callback
RUCAPTCHA_CALLBACK_URL=

# Set to 0 to globally disable auto-solver (default: 1)
EOPP_AUTO_SOLVER_ENABLED=1
