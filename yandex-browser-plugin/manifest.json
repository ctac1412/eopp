{
  "manifest_version": 3,
  "name": "EOPP Injector",
  "version": "1.0.0",
  "description": "Добавляет кнопку инжектора на страницы редактирования записей EOPP",
  "icons": {
    "48": "icon.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://eopp.epd-portal.ru/*",
    "https://china.alabai.netcraze.pro/*",
    "https://localhost:8765/*",
    "https://127.0.0.1:8765/*"
  ],
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://eopp.epd-portal.ru/ru/reservations/reservation/*",
        "https://localhost:8765/*",
        "https://127.0.0.1:8765/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
