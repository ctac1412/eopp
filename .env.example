# EOPP — Local Development Environment
# Copy to .env and fill in your values

# API key for rucaptcha.com auto-solver
RUCAPTCHA_API_KEY=

# Webhook URL for rucaptcha pingback
# Local dev with port forwarding: http://your-ip:8766/rucaptcha-callback
RUCAPTCHA_CALLBACK_URL=

# Disable auto-solver globally (0=off, 1=on)
EOPP_AUTO_SOLVER_ENABLED=1

# Admin token (default: 13243546)
# ADMIN_TOKEN=13243546
