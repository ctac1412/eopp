{
    // Используйте IntelliSense, чтобы узнать о возможных атрибутах.
    // Наведите указатель мыши, чтобы просмотреть описания существующих атрибутов.
    // Для получения дополнительной информации посетите: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Сервер HTTP",
            "type": "debugpy",
            "request": "launch",
            "program": "manage.py",
            "console": "integratedTerminal",
            "args": "--no-ssl"
        },
        {
            "name": "Test Captcha JS",
            "program": "${workspaceFolder}/test_captcha.js",
            "request": "launch",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "args": [
                "tests/test_cases/valid/188742fa80a73ebd.json",
            ],
            "type": "node"
        },
        {
            "name": "Test Captcha JS AUTO",
            "program": "${workspaceFolder}/test_captcha.js",
            "request": "launch",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "args": [
                "tests/test_cases/valid/188742fa80a73ebd.json",
                "--auto",
            ],
            "type": "node"
        },
        {
            "name": "Отладчик Python: текущий файл",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}