            "text": "{\n    \"esiaUrl\": \"https://esia.epd-portal.ru\",\n    \"baseUrl\": \"https://eopp.epd-portal.ru\",\n    \"authUrl\": \"https://eopp.epd-portal.ru/auth\",\n    \"apiGateUrl\": \"https://eopp.epd-portal.ru/api/v1\",\n    \"notificationsUrl\": \"https://eopp.epd-portal.ru/notifications/v1\",\n    \"notificationsDispatcherUrl\": \"https://eopp.epd-portal.ru/notifications-dispatcher/v1\",\n    \"activityLogUrl\": \"https://eopp.epd-portal.ru/activity-log/v1\",\n    \"fileStorageUrl\": \"https://eopp.epd-portal.ru/file-storage/v1\",\n    \"driverServiceUrl\": \"https://eopp.epd-portal.ru/drivers-api/v1\",\n    \"reservationQueueServiceUrl\": \"https://eopp.epd-portal.ru/reservation-queue/v1\",\n    \"vehicleServiceUrl\": \"https://eopp.epd-portal.ru/vehicles-api/v1\",\n    \"reportsServiceUrl\": \"https://eopp.epd-portal.ru/reports-api/v1\",\n    \"reservationManagerUrl\": \"https://eopp.epd-portal.ru/reservations-api/v1\",\n    \"registrationRequestsUrl\": \"https://eopp.epd-portal.ru/registration-requests-api/v1\",\n    \"operationalStatisticsUrl\": \"https://eopp.epd-portal.ru/statistic-api/v1\",\n    \"facilityUrl\": \"https://eopp.epd-portal.ru/facility\",\n    \"personalAgreementFile\": \"https://public.epd-portal.ru/assets/static_files/json/links/%D0%A1%D0%BE%D0%B3%D0%BB%D0%B0%D1%81%D0%B8%D0%B5_%D0%B8_%D0%BF%D0%BE%D0%BB%D0%B8%D1%82%D0%B8%D0%BA%D0%B0_%D0%BE%D0%B1%D1%80_%D0%9F%D0%94%D0%BD_%D0%9F%D0%BE%D1%80%D1%82%D0%B0%D0%BB_%D0%93%D0%98%D0%A1_%D0%AD%D0%9F%D0%94.pdf\",\n    \"personalAgreementFileEn\": \"https://public.epd-portal.ru/assets/static_files/json/links/Consent%20and%20Policy%20of%20personal%20data%20on%20the%20GIS%20EPD%20Portal.pdf\",\n    \"publicPortalLink\": \"https://public.epd-portal.ru\",\n    \"@comment theme\": \"Возможные варианты темы: blue/grey\",\n    \"theme\": \"blue\",\n    \"@comment idleTime\": \"Время бездействия пользователя до отключения в режиме ТСО, в секундах\",\n    \"idleTime\": 60,\n    \"@comment eoppStar