{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],

  "lsp": true,

  "plugin": [
    "opencode-type-inject",
    "opencode-md-table-formatter",
    "opencode-plugin-superpower",
    "opencode-snip"
  ],

  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false,
      "env": {
        "BROWSER": "chromium"
      }
    },
    "sqlite": {
      "type": "local",
      "command": ["uvx", "mcp-server-sqlite", "--db-path", "server/data/api_keys.db"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": true,
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "codegraph": {
      "type": "local",
      "command": ["npx", "-y", "@colbymchenry/codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic/mcp-sequential-thinking"],
      "enabled": true
    },
    "puppeteer": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic/mcp-puppeteer"],
      "enabled": false
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic/mcp-memory"],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": ["uvx", "mcp-server-git", "--repository", "."],
      "enabled": true
    },
    "docker": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic/mcp-docker"],
      "enabled": false
    },
    "time": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic/mcp-time"],
      "enabled": true
    }
  }
}
